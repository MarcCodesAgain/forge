{
  "expo": {
    "name": "Forge",
    "slug": "forge-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forge",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.marcllopis.forge",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.marcllopis.forge",
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#080808"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "be729b30-3fae-4b6c-a0bf-0910f686111b"
      },
      "router": {}
    },
    "description": "Registra tus entrenos de gimnasio: rutinas, series, pesos, progreso. Sin cuenta, todo en tu móvil."
  }
}
